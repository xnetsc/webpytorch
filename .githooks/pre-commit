#!/bin/sh
# Run every check in this directory. A non-zero exit from any one stops the commit.
#
# Each check judges the STAGED content, not the working tree, so it reports on the commit
# actually being made. Add a check by dropping in another executable `check-*.py`.
#
# Enable:  git config core.hooksPath .githooks
# Bypass:  git commit --no-verify
set -e
dir=$(dirname "$0")
status=0
for check in "$dir"/check-*.py; do
  [ -e "$check" ] || continue
  python3 "$check" || status=1
done
exit $status
